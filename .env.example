# Copy this file to .env and fill in real values before deploying.
# IMPORTANT: every variable prefixed with VITE_ is bundled into the
# client-side JavaScript and is publicly visible in the browser.
# Never place secret API keys, tokens, or credentials in VITE_ variables.

# Final production domain, no trailing slash (used for canonical URLs and JSON-LD)
VITE_SITE_URL=

# Endpoint that receives contact form submissions (e.g. a form backend or
# serverless function). Leave empty to show the "online submission is not
# configured" fallback instead of a fake success state.
VITE_CONTACT_FORM_ENDPOINT=

# Real company email address. Leave empty until one is supplied — the site
# will not fabricate or display a placeholder address to visitors.
VITE_COMPANY_EMAIL=

# Company LinkedIn URL. Leave empty until supplied.
VITE_LINKEDIN_URL=

# Controls how much address detail is shown publicly.
# Supported values: full | city-only | hidden
VITE_ADDRESS_VISIBILITY=city-only

# Whether to show a map link/embed. Keep false unless explicitly enabled.
VITE_SHOW_MAP_LINK=false
